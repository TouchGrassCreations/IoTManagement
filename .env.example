GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
CONFIRMATION_TOKEN_SECRET=

# Owner used when the platform injects no signed-in identity. Set this for local
# development and for a deliberately single-user private Site. Leave it UNSET in
# any deployment that anonymous visitors can reach: without it, an unidentified
# request is refused instead of landing in somebody else's cabinet.
ANONYMOUS_OWNER_ID=local-dev

# Identification budget per owner. Each defaults to a hobbyist-scale value when
# unset or invalid; identification spends money on every call.
IDENTIFY_RATE_LIMIT_PER_MINUTE=10
IDENTIFY_RATE_LIMIT_PER_HOUR=60
IDENTIFY_RATE_LIMIT_PER_DAY=200

# Node and container deployments only. On Cloudflare the D1 binding and the
# platform's migration step cover both of these.
DATABASE_PATH=./data/cabinet.db
MIGRATIONS_DIR=./drizzle

# Behind a proxy that authenticates visitors. When set, the app honours the
# identity headers only on requests that also carry this value, so a request
# that reaches the container some other way cannot claim to be anyone. Generate
# with `openssl rand -hex 32`. Leave unset on the Sites platform, where the
# dispatcher is the only thing that can reach the app.
TRUSTED_PROXY_SECRET=

# The proxy stack in docker-compose.yml. CABINET_DOMAIN is the hostname the
# certificate is issued for and must resolve to this machine.
CABINET_DOMAIN=
ACME_EMAIL=
OAUTH_PROVIDER=google
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=
# `openssl rand -base64 32`. Rotating it signs everyone out.
OAUTH_COOKIE_SECRET=
# Restrict who may sign in, e.g. `example.com`. `*` admits any account the
# provider will authenticate — and every scan spends your Gemini budget.
OAUTH_EMAIL_DOMAIN=*
