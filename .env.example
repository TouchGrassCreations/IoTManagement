GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
CONFIRMATION_TOKEN_SECRET=

# Owner used when the platform injects no signed-in identity. Set this for local
# development and for a deliberately single-user private Site. Leave it UNSET in
# any deployment that anonymous visitors can reach: without it, an unidentified
# request is refused instead of landing in somebody else's cabinet.
ANONYMOUS_OWNER_ID=local-dev
